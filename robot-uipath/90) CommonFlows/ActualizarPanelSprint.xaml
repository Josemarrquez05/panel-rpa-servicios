ring = &quot;--&quot;&#xA;        If estadoPrevioPorPaso.ContainsKey(numeroPaso) Then&#xA;            estadoPrevio = estadoPrevioPorPaso(numeroPaso)&#xA;        End If&#xA;        If horaPreviaPorPaso.ContainsKey(numeroPaso) AndAlso Not String.IsNullOrWhiteSpace(horaPreviaPorPaso(numeroPaso)) Then&#xA;            horaPrevia = horaPreviaPorPaso(numeroPaso)&#xA;        End If&#xA;&#xA;        Dim horaPaso As String = horaPrevia&#xA;        If estadoPaso &lt;&gt; estadoPrevio Then&#xA;            If estadoPaso = &quot;Sin comenzar&quot; Then&#xA;                horaPaso = &quot;--&quot;&#xA;            Else&#xA;                horaPaso = horaActual&#xA;            End If&#xA;        ElseIf String.IsNullOrWhiteSpace(horaPaso) Then&#xA;            horaPaso = &quot;--&quot;&#xA;        End If&#xA;&#xA;        nombrePaso = escaparJson(nombrePaso)&#xA;        descripcionPaso = escaparJson(descripcionPaso)&#xA;        horaPaso = escaparJson(horaPaso)&#xA;&#xA;        sb.AppendLine(&quot;    {&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;step_number&quot;&quot;: &quot; &amp; numeroPaso.ToString() &amp; &quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;step_name&quot;&quot;: &quot;&quot;&quot; &amp; nombrePaso &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;status&quot;&quot;: &quot;&quot;&quot; &amp; estadoPaso &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;description&quot;&quot;: &quot;&quot;&quot; &amp; descripcionPaso &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;updated_at&quot;&quot;: &quot;&quot;&quot; &amp; horaPaso &amp; &quot;&quot;&quot;&quot;)&#xA;&#xA;        If i = pasosSeparados.Length - 1 Then&#xA;            sb.AppendLine(&quot;    }&quot;)&#xA;        Else&#xA;            sb.AppendLine(&quot;    },&quot;)&#xA;        End If&#xA;    Next&#xA;&#xA;    sb.AppendLine(&quot;  ]&quot;)&#xA;    sb.AppendLine(&quot;}&quot;)&#xA;    S