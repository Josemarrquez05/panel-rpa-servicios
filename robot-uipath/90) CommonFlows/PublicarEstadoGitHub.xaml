    <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Plantilla comun para publicar en GitHub el JSON ya actualizado por el sprint. Si falta token o configuracion, sale sin detener el robot." Code="Try&#xA;    Dim publicarGitHubTexto As String = If(io_publicarGitHub_Str, &quot;&quot;).Trim()&#xA;    If Not publicarGitHubTexto.Equals(&quot;True&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    Dim rutaArchivoLocal As String = If(io_rutaJson_Str, &quot;&quot;).Trim()&#xA;    Dim ownerGitHub As String = If(io_gitHubOwner_Str, &quot;&quot;).Trim()&#xA;    Dim repoGitHub As String = If(io_gitHubRepo_Str, &quot;&quot;).Trim()&#xA;    Dim ramaGitHub As String = If(io_gitHubBranch_Str, &quot;&quot;).Trim()&#xA;    Dim tokenGitHub As String = If(io_gitHubToken_Str, &quot;&quot;).Trim()&#xA;    Dim rutaBaseRepo As String = If(io_gitHubRutaBaseRepo_Str, &quot;data&quot;).Trim()&#xA;&#xA;    If String.IsNullOrWhiteSpace(rutaArchivoLocal) OrElse Not System.IO.File.Exists(rutaArchivoLocal) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    If String.IsNullOrWhiteSpace(ownerGitHub) OrElse String.IsNullOrWhiteSpace(repoGitHub) OrElse String.IsNullOrWhiteSpace(tokenGitHub) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    If String.IsNullOrWhiteSpace(ramaGitHub) Then&#xA;        ramaGitHub = &quot;main&quot;&#xA;    End If&#xA;&#xA;    If String.IsNullOrWhiteSpace(rutaBaseRepo) Then&#xA;        rutaBaseRepo = &quot;data&quot;&#xA;    End If&#xA;&#xA;    Dim nombreArchivoJson As String = System.IO.Path.GetFileName(rutaArchivoLocal)&#xA;    If String.IsNullOrWhiteSpace(nombreArchivoJson) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    Dim rutaRepositorio As String = rutaBaseRepo.Replace(&quot;\&quot;, &quot;/&quot;).Trim(&quot;/&quot;c)&#xA;    If String.IsNullOrWhiteSpace(rutaRepositorio) Then&#xA;        rutaRepositorio = nombreArchivoJson&#xA;    Else&#xA;        rutaRepositorio = rutaRepositorio &amp; &quot;/&quot; &amp; nombreArchivoJson&#xA;    End If&#xA;&#xA;    Dim rutaRepositorioUrl As New System.Text.StringBuilder()&#xA;    For Each segmentoRuta As String In rutaRepositorio.Split(&quot;/&quot;c)&#xA;        If Not String.IsNullOrWhiteSpace(segmentoRuta) Then&#xA;            If rutaRepositorioUrl.Length &gt; 0 Then&#xA;                rutaRepositorioUrl.Append(&quot;/&quot;)&#xA;            End If&#xA;            rutaRepositorioUrl.Append(Uri.EscapeDataString(segmentoRuta.Trim()))&#xA;        End If&#xA;    Next&#xA;&#xA;    If rutaRepositorioUrl.Length = 0 Then&#xA;        Return&#xA;    End If&#xA;&#xA;    Dim urlBase As String = &quot;https://api.github.com/repos/&quot; &amp; Uri.EscapeDataString(ownerGitHub) &amp; &quot;/&quot; &amp; Uri.EscapeDataString(repoGitHub) &amp; &quot;/contents/&quot; &amp; rutaRepositorioUrl.ToString()&#xA;    Dim urlConsulta As String = urlBase &amp; &quot;?ref=&quot; &amp; Uri.EscapeDataString(ramaGitHub)&#xA;    Dim shaArchivo As String = &quot;&quot;&#xA;    Dim contenidoArchivoBase64 As String = Convert.ToBase64String(System.IO.File.ReadAllBytes(rutaArchivoLocal))&#xA;&#xA;    Try&#xA;        System.Net.ServicePointManager.SecurityProtocol = CType(3072, System.Net.SecurityProtocolType)&#xA;    Catch&#xA;    End Try&#xA;&#xA;    Using clienteConsulta As New System.Net.WebClient()&#xA;        clienteConsulta.Encoding = System.Text.Encoding.UTF8&#xA;        clienteConsulta.Headers(&quot;Authorization&quot;) = &quot;Bearer &quot; &amp; tokenGitHub&#xA;        clienteConsulta.Headers(&quot;Accept&quot;) = &quot;application/vnd.github+json&quot;&#xA;        clienteConsulta.Headers(&quot;X-GitHub-Api-Version&quot;) = &quot;2022-11-28&quot;&#xA;        clienteConsulta.Headers(&quot;User-Agent&quot;) = &quot;UiPath-RPA-Panel&quot;&#xA;&#xA;        Try&#xA;            Dim respuestaGet As String = clienteConsulta.DownloadString(urlConsulta)&#xA;            Dim indiceSha As Integer = respuestaGet.IndexOf(&quot;&quot;&quot;sha&quot;&quot;&quot;, StringComparison.OrdinalIgnoreCase)&#xA;            If indiceSha &gt;= 0 Then&#xA;                indiceSha = respuestaGet.IndexOf(&quot;:&quot;, indiceSha)&#xA;                If indiceSha &gt;= 0 Then&#xA;                    indiceSha = respuestaGet.IndexOf(&quot;&quot;&quot;&quot;, indiceSha)&#xA;                    If indiceSha &gt;= 0 Then&#xA;                        indiceSha = indiceSha + 1&#xA;                        Dim finSha As Integer = respuestaGet.IndexOf(&quot;&quot;&quot;&quot;, indiceSha)&#xA;                        If finSha &gt; indiceSha Then&#xA;                            shaArchivo = respuestaGet.Substring(indiceSha, finSha - indiceSha)&#xA;                        End If&#xA;                    End If&#xA;                End If&#xA;            End If&#xA;        Catch exWeb As System.Net.WebException&#xA;            Dim respuestaHttp As System.Net.HttpWebResponse = TryCast(exWeb.Response, System.Net.HttpWebResponse)&#xA;            If respuestaHttp Is Nothing OrElse respuestaHttp.StatusCode &lt;&gt; System.Net.HttpStatusCode.NotFound Then&#xA;                Return&#xA;            End If&#xA;        End Try&#xA;    End Using&#xA;&#xA;    Dim mensajeCommit As String = &quot;Actualiza &quot; &amp; If(io_nombreSprint_Str, &quot;Sprint&quot;).Trim() &amp; &quot; paso &quot; &amp; If(io_pasoActual_Str, &quot;1&quot;).Trim() &amp; &quot; &quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)&#xA;    mensajeCommit = mensajeCommit.Replace(&quot;\&quot;, &quot;\\&quot;).Replace(&quot;&quot;&quot;&quot;, &quot;\&quot;&quot;&quot;)&#xA;    Dim ramaGitHubJson As String = ramaGitHub.Replace(&quot;\&quot;, &quot;\\&quot;).Replace(&quot;&quot;&quot;&quot;, &quot;\&quot;&quot;&quot;)&#xA;    Dim shaArchivoJson As String = shaArchivo.Replace(&quot;\&quot;, &quot;\\&quot;).Replace(&quot;&quot;&quot;&quot;, &quot;\&quot;&quot;&quot;)&#xA;&#xA;    Dim payload As New System.Text.StringBuilder()&#xA;    payload.AppendLine(&quot;{&quot;)&#xA;    payload.AppendLine(&quot;  &quot;&quot;message&quot;&quot;: &quot;&quot;&quot; &amp; mensajeCommit &amp; &quot;&quot;&quot;,&quot;)&#xA;    payload.AppendLine(&quot;  &quot;&quot;content&quot;&quot;: &quot;&quot;&quot; &amp; contenidoArchivoBase64 &amp; &quot;&quot;&quot;,&quot;)&#xA;    payload.AppendLine(&quot;  &quot;&quot;branch&quot;&quot;: &quot;&quot;&quot; &amp; ramaGitHubJson &amp; &quot;&quot;&quot;&quot;)&#xA;    If Not String.IsNullOrWhiteSpace(shaArchivoJson) Then&#xA;        payload.AppendLine(&quot;  ,&quot;&quot;sha&quot;&quot;: &quot;&quot;&quot; &amp; shaArchivoJson &amp; &quot;&quot;&quot;&quot;)&#xA;    End If&#xA;    payload.AppendLine(&quot;}&quot;)&#xA;&#xA;    Using clienteActualizacion As New System.Net.WebClient()&#xA;        clienteActualizacion.Encoding = System.Text.Encoding.UTF8&#xA;        clienteActualizacion.Headers(&quot;Authorization&quot;) = &quot;Bearer &quot; &amp; tokenGitHub&#xA;        clienteActualizacion.Headers(&quot;Accept&quot;) = &quot;application/vnd.github+json&quot;&#xA;        clienteActualizacion.Headers(&quot;X-GitHub-Api-Version&quot;) = &quot;2022-11-28&quot;&#xA;        clienteActualizacion.Headers(&quot;User-Agent&quot;) = &quot;UiPath-RPA-Panel&quot;&#xA;        clienteActualizacion.Headers(&quot;Content-Type&quot;) = &quot;application/json&quot;&#xA;        clienteActualizacion.UploadString(urlBase, &quot;PUT&quot;, payload.ToString())&#xA;    End Using&#xA;Catch ex As Exception&#xA;End Try" DisplayName="Publicar JSON del sprint en GitHub" sap:VirtualizedContainerService.HintSize="530,214" sap2010:WorkflowViewState.IdRef="InvokeCode_PublicarEstadoGitHub">
