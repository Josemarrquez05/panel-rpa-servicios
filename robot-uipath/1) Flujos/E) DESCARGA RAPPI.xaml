                      </ui:MultipleAssign><ui:InvokeCode sap2010:Annotation.AnnotationText="Sprint RAPPI: actualiza el panel cuando el robot entra al Paso 4 del sprint." DisplayName="Actualizar sprint RAPPI - Paso 4" sap:VirtualizedContainerService.HintSize="416,89.6" sap2010:WorkflowViewState.IdRef="InvokeCode_RAPPI_Step4" Code="Try&#xA;    Dim rutaCarpeta As String = System.IO.Path.GetDirectoryName(rutaJson)&#xA;    If Not System.IO.Directory.Exists(rutaCarpeta) Then&#xA;        System.IO.Directory.CreateDirectory(rutaCarpeta)&#xA;    End If&#xA;&#xA;    Dim formatoFecha As String = &quot;yyyy-MM-dd HH:mm:ss&quot;&#xA;    Dim ahora As DateTime = DateTime.Now&#xA;    Dim horaActual As String = ahora.ToString(&quot;HH:mm:ss&quot;)&#xA;    Dim nombresPasos As String() = {&quot;Generar y Descargar Archivo&quot;, &quot;Log In&quot;, &quot;Generar Archivo&quot;, &quot;Descargar Archivo&quot;}&#xA;    Dim descripcionesPasos As String() = {&quot;Ejecuta el bloque principal de generacion y descarga del reporte.&quot;, &quot;Ingresa al portal de Rappi con las credenciales configuradas.&quot;, &quot;Selecciona filtros y solicita la creacion del reporte.&quot;, &quot;Espera la descarga y mueve el archivo generado.&quot;}&#xA;    Dim pasoActualNumero As Integer = Integer.Parse(pasoActual)&#xA;    Dim finalizarProcesoValor As Boolean = Boolean.Parse(finalizarProceso)&#xA;    Dim inicioSprint As DateTime = ahora&#xA;&#xA;    If pasoActualNumero = 1 AndAlso Not finalizarProcesoValor Then&#xA;        inicioSprint = ahora&#xA;    ElseIf System.IO.File.Exists(rutaJson) Then&#xA;        Dim jsonAnterior As String = System.IO.File.ReadAllText(rutaJson)&#xA;        Dim coincidenciaInicio As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(jsonAnterior, &quot;&quot;&quot;startedAt&quot;&quot;\s*:\s*&quot;&quot;([^&quot;&quot;]+)&quot;&quot;&quot;)&#xA;&#xA;        If coincidenciaInicio.Success Then&#xA;            Dim textoInicio As String = coincidenciaInicio.Groups(1).Value&#xA;            If Not DateTime.TryParseExact(textoInicio, formatoFecha, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, inicioSprint) Then&#xA;                inicioSprint = ahora&#xA;            End If&#xA;        End If&#xA;    End If&#xA;&#xA;    Dim duracionSprint As TimeSpan = ahora - inicioSprint&#xA;    Dim duracionSegundos As Integer = CInt(Math.Floor(duracionSprint.TotalSeconds))&#xA;    Dim duracionTexto As String = duracionSprint.ToString(&quot;hh\:mm\:ss&quot;)&#xA;    Dim inicioTexto As String = inicioSprint.ToString(formatoFecha)&#xA;    Dim finTexto As String = &quot;&quot;&#xA;&#xA;    If finalizarProcesoValor Then&#xA;        finTexto = ahora.ToString(formatoFecha)&#xA;    End If&#xA;&#xA;    Dim sb As New System.Text.StringBuilder()&#xA;    sb.AppendLine(&quot;{&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;processName&quot;&quot;: &quot;&quot;&quot; &amp; nombreProceso &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;startedAt&quot;&quot;: &quot;&quot;&quot; &amp; inicioTexto &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;durationSeconds&quot;&quot;: &quot; &amp; duracionSegundos.ToString() &amp; &quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;durationLabel&quot;&quot;: &quot;&quot;&quot; &amp; duracionTexto &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;completedAt&quot;&quot;: &quot;&quot;&quot; &amp; finTexto &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;lastUpdated&quot;&quot;: &quot;&quot;&quot; &amp; horaActual &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;lastDatabaseUpdate&quot;&quot;: &quot;&quot;&quot; &amp; horaActual &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;steps&quot;&quot;: [&quot;)&#xA;&#xA;    For i As Integer = 0 To nombresPasos.Length - 1&#xA;        Dim estadoPaso As String = &quot;Sin comenzar&quot;&#xA;&#xA;        If finalizarProcesoValor Then&#xA;            estadoPaso = &quot;Finalizado&quot;&#xA;        ElseIf i &lt; pasoActualNumero - 1 Then&#xA;            estadoPaso = &quot;Finalizado&quot;&#xA;        ElseIf i = pasoActualNumero - 1 Then&#xA;            estadoPaso = &quot;En proceso&quot;&#xA;        End If&#xA;&#xA;        sb.AppendLine(&quot;    {&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;step_number&quot;&quot;: &quot; &amp; (i + 1).ToString() &amp; &quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;step_name&quot;&quot;: &quot;&quot;&quot; &amp; nombresPasos(i) &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;status&quot;&quot;: &quot;&quot;&quot; &amp; estadoPaso &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;description&quot;&quot;: &quot;&quot;&quot; &amp; descripcionesPasos(i) &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;updated_at&quot;&quot;: &quot;&quot;&quot; &amp; horaActual &amp; &quot;&quot;&quot;&quot;)&#xA;&#xA;        If i = nombresPasos.Length - 1 Then&#xA;            sb.AppendLine(&quot;    }&quot;)&#xA;        Else&#xA;            sb.AppendLine(&quot;    },&quot;)&#xA;        End If&#xA;    Next&#xA;&#xA;    sb.AppendLine(&quot;  ]&quot;)&#xA;    sb.AppendLine(&quot;}&quot;)&#xA;    System.IO.File.WriteAllText(rutaJson, sb.ToString(), System.Text.Encoding.UTF8)&#xA;Catch ex As Exception&#xA;End Try"><ui:InvokeCode.Arguments><scg:Dictionary x:TypeArguments="x:String, Argument"><InArgument x:TypeArguments="x:String" x:Key="rutaJson">["C:\RPA Servicios\data\rappi.json"]</InArgument><InArgument x:TypeArguments="x:String" x:Key="nombreProceso">["Sprint RAPPI"]</InArgument><InArgument x:TypeArguments="x:String" x:Key="pasoActual">["4"]</InArgument><InArgument x:TypeArguments="x:String" x:Key="finalizarProceso">["False"]</InArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:I